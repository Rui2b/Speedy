# Speedy systemd unit.
#
# systemd is used instead of PM2 because PM2 is AGPL-3.0, which conflicts with
# this project's rule of no copyleft dependencies. systemd gives the same
# boot-on-start, crash-restart and journald logging.
#
# Install with deploy/install.sh.

[Unit]
Description=Speedy authoritative game server
Documentation=file:///opt/speedy/README.md
After=network-online.target docker.service
Wants=network-online.target
# Restart budget, so a broken build cannot spin forever
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=speedy
Group=speedy
WorkingDirectory=/opt/speedy
EnvironmentFile=/opt/speedy/.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node server/index.js

Restart=always
RestartSec=3

# Graceful shutdown: SIGTERM first, SIGKILL only after 20s
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=speedy

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Only the log directory is writable
ReadWritePaths=/opt/speedy/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Ceiling so one process cannot eat the whole small instance
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
