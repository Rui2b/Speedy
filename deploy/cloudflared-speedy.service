[Unit]
Description=Cloudflare Tunnel for the Speedy game origin
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target speedy.service
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30
# Separate from the cloudflared instance the control panel uses
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/speedy-game.yml tunnel run
Restart=always
RestartSec=5s
# Carries public traffic, keep the OOM killer away from it
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
