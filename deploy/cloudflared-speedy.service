[Unit]
Description=Cloudflare Tunnel for Speedy game origin (speedy-origin.potatoedu.cc)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
After=network-online.target speedy.service
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30
# 独立于 1Panel 使用的 cloudflared 实例,互不影响
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/speedy-game.yml tunnel run
Restart=always
RestartSec=5s
# 承载公网流量,不要被 OOM killer 优先干掉
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
