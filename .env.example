# ---------------------------------------------------------------------------
# Speedy 环境变量模板
# 复制成 .env 后填入真实值。.env 已被 .gitignore 忽略,不会提交到仓库。
# 全部数值型变量都有内置默认值,缺省时按 server/config.js 中的默认值运行。
# ---------------------------------------------------------------------------

# --- 网络 -----------------------------------------------------------------
# Node 只监听本机回环,公网入口由 Cloudflare Tunnel 提供。
HOST=127.0.0.1
PORT=8080

# --- 数据库 ---------------------------------------------------------------
# 指向服务器上的 PostgreSQL。留空则拒绝启动(生产模式必须有数据库)。
DATABASE_URL=postgres://speedy:CHANGE_ME@127.0.0.1:5432/speedy
# 连接池上限。Always Free 小机器建议 5~10。
PG_POOL_MAX=8
# 启动时是否自动建表(等价于执行 db/init.sql 中的 CREATE ... IF NOT EXISTS)。
DB_AUTO_MIGRATE=true

# --- 会话签名 -------------------------------------------------------------
# 必填。生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_随机字符串
# 会话 token 有效期(小时)
SESSION_TTL_HOURS=12

# --- 权威模拟参数(服务器唯一真值,客户端不可控)--------------------------
TICK_RATE=20
BROADCAST_RATE=10
MAX_ONLINE=30

# 玩家物理
PLAYER_MAX_SPEED=6
PLAYER_ACCELERATION=12
PLAYER_FRICTION=0.9
PLAYER_JUMP_IMPULSE=7.5
PLAYER_GRAVITY=22
# 输入过期时间(毫秒)。超过这么久没收到新输入包就按"无输入"处理。
# 必须大于后台标签页 5Hz 的上报间隔(200ms),否则切标签页会被误判成松手。
INPUT_STALE_MS=450

# 防作弊阈值
# 客户端上报坐标单 tick 位移允许的倍数(1.0 = 精确等于理论最大值)
CHEAT_DISPLACEMENT_TOLERANCE=1.45
# 客户端上报坐标与服务器权威坐标允许的最大漂移(单位)
CHEAT_MAX_DRIFT=3.5
# 连续多少次异常才断开连接(0 = 从不断开,只记录日志)
CHEAT_STRIKES_BEFORE_KICK=8
# 每秒允许的输入包上限
MAX_INPUT_PACKETS_PER_SEC=22
# 每秒允许的操作请求包上限
MAX_ACTION_PACKETS_PER_SEC=10

# --- 日志 -----------------------------------------------------------------
LOG_LEVEL=info
CHEAT_LOG_FILE=logs/cheat.log

# --- Cloudflare Turnstile 人机认证 ---------------------------------------
# 注册与登录必须先过人机校验。两个 key 都用 Cloudflare 上已有的变量名。
# 注意:Cloudflare Dashboard 上 SECRET 被拼成了 SECRECT,这里按原样读取;
# 正确的拼写也接受,免得哪天你改对了反而失效。
#
# 生产环境这两个 key 存在 Worker 的环境变量里,由 Worker 随请求头下发到源站,
# 不需要写进服务器 .env。这里填是为了本地开发能跑起来。
#
# 未配置时注册与登录一律拒绝(返回 503 captcha_failed / not_configured)。
# 想本地跑测试,用 Cloudflare 官方测试 key:
#   SITE:   1x00000000000000000000AA
#   SECRET: 1x0000000000000000000000000000000AA   (始终通过)
#   1x00000000000000000000AB / 2x0000000000000000000000000000000AA (始终失败)
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRECT_KEY=

# --- 源站保护 -------------------------------------------------------------
# 源站域名(speedy-origin.*)是公网可直连的。Worker 转发时带上这个共享密钥,
# 源站只接受带了正确头的请求,从而保证所有流量必须经过 Worker。
# 不配的话,任何人直接打源站就能绕过 Turnstile。
#
# 必须与 Worker 上的 ORIGIN_SHARED_SECRET 一致。生成方式:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ORIGIN_SHARED_SECRET=
