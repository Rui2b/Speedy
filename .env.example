# ---------------------------------------------------------------------------
# Speedy environment template
# Copy to .env and fill in real values. .env is gitignored.
# Every numeric value has a built-in default in server/config.js, so a missing
# line simply falls back to that default.
# ---------------------------------------------------------------------------

# --- Network --------------------------------------------------------------
# Node binds to loopback only. Public traffic arrives through Cloudflare Tunnel.
HOST=127.0.0.1
PORT=8080

# --- Database -------------------------------------------------------------
# Required in production. The server refuses to start without it.
DATABASE_URL=postgres://speedy:CHANGE_ME@127.0.0.1:5432/speedy
# Connection pool ceiling. Keep it low on a small Always Free instance.
PG_POOL_MAX=8
# Create missing tables on boot (equivalent to db/init.sql).
DB_AUTO_MIGRATE=true

# --- Session signing ------------------------------------------------------
# Required. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_random_string
# Session lifetime in hours
SESSION_TTL_HOURS=12

# --- Authoritative simulation --------------------------------------------
TICK_RATE=20
BROADCAST_RATE=10
MAX_ONLINE=30

# Player physics
PLAYER_MAX_SPEED=6
PLAYER_ACCELERATION=12
PLAYER_FRICTION=0.9
PLAYER_JUMP_IMPULSE=7.5
PLAYER_GRAVITY=22
# Input older than this is treated as no input. Keep it above the 200ms
# background reporting interval.
INPUT_STALE_MS=450

# --- Anti-cheat thresholds ------------------------------------------------
# Multiplier on the maximum theoretical displacement per packet
CHEAT_DISPLACEMENT_TOLERANCE=1.45
# Maximum sustained distance between reported and authoritative position
CHEAT_MAX_DRIFT=3.5
# Strikes before the connection is dropped. 0 only logs.
CHEAT_STRIKES_BEFORE_KICK=8
# Packets per second, per connection
MAX_INPUT_PACKETS_PER_SEC=22
MAX_ACTION_PACKETS_PER_SEC=10

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info
CHEAT_LOG_FILE=logs/cheat.log
